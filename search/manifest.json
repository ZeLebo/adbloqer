{
  "manifest_version": 3,
  "name": "Adbloqer for Search",
  "version": "1.0.0",
  "description": "Отключает рекламный модуль поддерживаемого видеоплеера Ceramet.",
  "content_scripts": [
    {
      "matches": ["https://ceramet.net/bil/*"],
      "js": ["player.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
